<?xml version="1.0" encoding="UTF-8"?>
<!--
  aimedia 模块 pom。

  两种用法：
  1) 默认（reference 骨架）：`mvn compile` 会把 src/main/java 全部编译。原有 controller
     依赖 com.yanque.common.*（来自 yq-admin 父工程，此处缺失），因此会出现"飘红/编译失败"，
     属预期。本模块作为对照代码，真实构建方式是把 src 合并回 yq-admin 对应模块。

  2) 启动器模式（profile: launcher）：`mvn -Plauncher spring-boot:run`
     只编译 com/yanque/aimedia/MavwApplication.java 与 com/yanque/aimedia/launcher/**，
     排除依赖缺失 common 的其它包，从而可以独立启动：
       - 端口 8088（见 application-launcher.properties）
       - 前端静态页来自 backend-java/frontend（零构建）
       - /api/** 反代到 Python 渲染引擎（默认 http://127.0.0.1:8010）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.yanque</groupId>
  <artifactId>aimedia-module</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>aimedia-module</name>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.2.5</spring-boot.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <version>${spring-boot.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
      <version>${spring-boot.version}</version>
    </dependency>
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
      <version>3.0.3</version>
    </dependency>
    <dependency>
      <groupId>com.github.pagehelper</groupId>
      <artifactId>pagehelper-spring-boot-starter</artifactId>
      <version>2.1.0</version>
    </dependency>
    <dependency>
      <groupId>com.alibaba.fastjson2</groupId>
      <artifactId>fastjson2</artifactId>
      <version>2.0.49</version>
    </dependency>
    <dependency>
      <groupId>cn.hutool</groupId>
      <artifactId>hutool-all</artifactId>
      <version>5.8.27</version>
    </dependency>
    <dependency>
      <groupId>com.volcengine</groupId>
      <artifactId>ve-tos-java-sdk</artifactId>
      <version>2.8.5</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.17.0</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.13</version>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.32</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- 启动器模式：只编译 MavwApplication + launcher 子包，可独立启动 -->
    <profile>
      <id>launcher</id>
      <build>
        <finalName>aimedia-launcher</finalName>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>3.11.0</version>
            <configuration>
              <excludes>
                <!-- 排除依赖缺失 common 的包，只留启动器本身 -->
                <exclude>com/yanque/aimedia/biz/**</exclude>
                <exclude>com/yanque/aimedia/common/**</exclude>
                <exclude>com/yanque/aimedia/config/**</exclude>
                <exclude>com/yanque/aimedia/controller/**</exclude>
                <exclude>com/yanque/aimedia/enums/**</exclude>
                <exclude>com/yanque/aimedia/handler/**</exclude>
                <exclude>com/yanque/aimedia/mapper/**</exclude>
                <exclude>com/yanque/aimedia/pojo/**</exclude>
                <exclude>com/yanque/aimedia/scheduler/**</exclude>
                <exclude>com/yanque/aimedia/service/**</exclude>
              </excludes>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <version>${spring-boot.version}</version>
            <configuration>
              <mainClass>com.yanque.aimedia.MavwApplication</mainClass>
              <addResources>true</addResources>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>repackage</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  mavw-standalone/backend —— 独立 Spring Boot 后端（真·前后端分离工程）。

  与 backend-java/aimedia-module（didi 对照模块，依赖 yq-admin 父工程的 com.yanque.common.*，
  无法独立构建）完全无关，本工程自包含、可直接在 IDEA 对 MavwApplication 点 Run 启动。

  职责：对前端暴露完整的 /api/** REST 接口层；内部用 RestClient 转发给 Python 渲染引擎
  （默认 http://127.0.0.1:8010），从而保留原有出图 / TTS / 字幕 / 渲染能力。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>com.mavw</groupId>
  <artifactId>mavw-standalone-backend</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>mavw-standalone-backend</name>
  <description>Multi-Agent Video Workflow standalone backend</description>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

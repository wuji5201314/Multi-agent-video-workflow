# ===== 成片画面 =====
MEDIA_RENDER_WIDTH=1080
MEDIA_RENDER_HEIGHT=1920
MEDIA_RENDER_FPS=30
MEDIA_RENDER_CRF=22
MEDIA_RENDER_PRESET=veryfast
MEDIA_RENDER_TIMEOUT_SECONDS=900
MEDIA_RENDER_CLIP_MIN_MS=2600
MEDIA_RENDER_CLIP_MAX_MS=15000

# ===== 字幕（默认整句；word=逐字弹出） =====
MEDIA_RENDER_SUBTITLE_ENABLED=true
MEDIA_RENDER_SUBTITLE_MODE=sentence
MEDIA_RENDER_SUBTITLE_MAX_CHARS=14
MEDIA_RENDER_SUBTITLE_FONT=Microsoft YaHei
MEDIA_RENDER_SUBTITLE_FONT_SIZE=60
MEDIA_RENDER_SUBTITLE_MARGIN_V=420
MEDIA_RENDER_SUBTITLE_POP=false

# ===== 数字人画中画（L2：角标小窗，与主画面、字幕三层不打架） =====
# 关闭时不产生任何额外算力开销，成片与原来完全一致
DIGITAL_HUMAN_ENABLED=false
# placeholder=离线占位主播（零算力，先验证版式）
# wav2lip=本地轻量对口型（约 2-4GB 显存，适合小窗）
# api=远程推理（本地不占显存，效果最好）
DIGITAL_HUMAN_PROVIDER=placeholder
DIGITAL_HUMAN_PIP_WIDTH=320
DIGITAL_HUMAN_PIP_HEIGHT=400
# top-right / top-left / bottom-left / bottom-right；bottom-* 会自动让出字幕与标签条
DIGITAL_HUMAN_PIP_POSITION=top-right
DIGITAL_HUMAN_PIP_MARGIN=48
DIGITAL_HUMAN_PIP_RADIUS=26
DIGITAL_HUMAN_PIP_BORDER=4
# 形象参考图：留空则自动取第一镜素材，视频素材抽首帧
DIGITAL_HUMAN_REFERENCE_IMAGE=
# 按「参考图 + 音频 + 尺寸 + provider」的内容哈希缓存；
# 只改标题文案时音频未变，不会重烧算力
DIGITAL_HUMAN_CACHE_DIR=
DIGITAL_HUMAN_TIMEOUT_SECONDS=1800

# --- provider=wav2lip 时需要 ---
DIGITAL_HUMAN_WAV2LIP_DIR=
DIGITAL_HUMAN_WAV2LIP_CHECKPOINT=
DIGITAL_HUMAN_WAV2LIP_STATIC=false
# 留空则用当前解释器
DIGITAL_HUMAN_PYTHON=

# --- provider=api 时需要 ---
DIGITAL_HUMAN_API_URL=
DIGITAL_HUMAN_API_KEY=
DIGITAL_HUMAN_API_IMAGE_FIELD=image
DIGITAL_HUMAN_API_AUDIO_FIELD=audio

# ===== BGM =====
MEDIA_RENDER_BGM_ENABLED=false
MEDIA_RENDER_BGM_DIR=
MEDIA_RENDER_BGM_VOLUME=0.2

# ===== 配音（edge 免费；openai 走兼容接口；silent 无音轨） =====
MEDIA_RENDER_TTS_PROVIDER=edge
MEDIA_RENDER_TTS_VOICE=zh-CN-YunxiNeural
MEDIA_RENDER_TTS_RATE=+8%
MEDIA_RENDER_TTS_VOLUME=+0%
MEDIA_RENDER_TTS_BASE_URL=
MEDIA_RENDER_TTS_API_KEY=
MEDIA_RENDER_TTS_MODEL=
MEDIA_RENDER_TTS_SPEED=1.0
MEDIA_RENDER_TTS_MAX_CHARS=240
MEDIA_RENDER_TTS_TIMEOUT_SECONDS=120
MEDIA_RENDER_TTS_FALLBACK_SILENT=true

# ===== FFmpeg（留空则用 imageio-ffmpeg 自带二进制） =====
MEDIA_RENDER_FFMPEG_PATH=
MEDIA_RENDER_FFPROBE_PATH=

# ===== 存储：local=写 output/assets；presign=回 yq-admin 取 TOS 预签名 =====
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=
YANQUE_ADMIN_BASE_URL=http://127.0.0.1:8080
YANQUE_INTERNAL_API_KEY=
PRESIGN_ENDPOINT=/yq-admin/internal/ai/content-preview-assets/presign

# ===== 大模型（留空则用内置模板，离线也能跑通链路） =====
# NVIDIA NIM：文本推理用 deepseek-v4.1-flash
BASE_URL=https://integrate.api.nvidia.com/v1
API_KEY=
LLM_MODEL=deepseek-ai/deepseek-v4.1-flash
LLM_TIMEOUT_SECONDS=180
# 推理型模型思考也吃 token，给小了 content 会是空的
LLM_MAX_TOKENS=3000
# NIM 的 deepseek 打开 json_object 会把结果写进 reasoning_content，保持关闭
LLM_JSON_MODE=false

# ===== 素材生成（模型出图） =====
# placeholder=Pillow 排版卡（默认）；nvidia=调用 NVIDIA NIM 的 flux-3-image-klein
IMAGE_PROVIDER=placeholder
IMAGE_API_BASE=https://ai.api.nvidia.com/v1/genai
IMAGE_API_KEY=
IMAGE_MODEL=black-forest-labs/flux-3-image-klein
# flux 的合法比例里没有 9:16，1:2 最接近竖屏，出图后统一裁成 1080x1920
IMAGE_ASPECT_RATIO=1:2
IMAGE_SEED=0
IMAGE_TIMEOUT_SECONDS=180
IMAGE_RETRIES=3

# ===== 管线 =====
PIPELINE_DB_PATH=
PIPELINE_OUTPUT_DIR=
PIPELINE_AUTO_APPROVE=false
PIPELINE_TOPIC_CANDIDATES=3
PIPELINE_SHOT_COUNT=4
# 已有 AI 生成图目录：填了就直接当素材用，不填才用 Pillow 生成占位卡
PIPELINE_MATERIAL_DIR=

# ===== 发布（不填就只生成发布单 JSON） =====
PUBLISH_WEBHOOK_URL=

# ===== 前端（默认 backend-java/frontend，留空自动探测） =====
WEB_ROOT=
# 前端被部署到别处时用来放行跨源，逗号分隔；* 表示全放开
CORS_ORIGINS=*
